let crdResource =
  apiVersion: "apiextensions.k8s.io/v1"
  kind: "CustomResourceDefinition"
  metadata:
    name: "widgets.e2e.example.com"
  spec:
    group: "e2e.example.com"
    scope: "Namespaced"
    names:
      plural: "widgets"
      singular: "widget"
      kind: "Widget"
      listKind: "WidgetList"
    versions:
      - name: "v1"
        served: true
        storage: true
        schema:
          openAPIV3Schema:
            type: "object"
            properties:
              spec:
                type: "object"
                properties:
                  value:
                    type: "string"
let crd = lifecycle.attach(crdResource, ["bootstrap"], 0, true, [])
let widget =
  apiVersion: "e2e.example.com/v1"
  kind: "Widget"
  metadata:
    name: "mcl-e2e-widget"
  spec:
    value: "created-after-crd"
emit crd
emit widget
